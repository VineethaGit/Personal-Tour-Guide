', response.text, re.DOTALL)\n            if match:\n                output = json.loads(match.group())\n            else:\n                raise ValueError(\"Gemini response was not valid JSON.\")\n\n            coords = output.get(\"coordinates\", None)\n            if coords and isinstance(coords, list) and len(coords) == 2:\n                coords = tuple(coords)\n            else:\n                coords = None\n\n            return {\n                \"landmark\": output.get(\"landmark\", \"Unknown\"),\n                \"city\": output.get(\"city\", \"Unknown\"),\n                \"country\": output.get(\"country\", \"Unknown\"),\n                \"description\": output.get(\"description\", \"No description provided.\"),\n                \"coordinates\": coords\n            }\n\n        except Exception as e:\n            error(f\"Gemini failed to analyze image: {e}\")\n            return {\n                \"landmark\": \"Unknown\",\n                \"city\": \"Unknown\",\n                \"country\": \"Unknown\",\n                \"description\": \"Analysis failed.\",\n                \"coordinates\": None\n            }","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-21T03:31:27.853235Z","iopub.execute_input":"2025-04-21T03:31:27.853636Z","iopub.status.idle":"2025-04-21T03:31:27.862332Z","shell.execute_reply.started":"2025-04-21T03:31:27.85361Z","shell.execute_reply":"2025-04-21T03:31:27.861432Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# === Weather Info ===\ndef get_weather(lat, lon):\n    try:\n        url = (\n            f\"https://api.openweathermap.org/data/2.5/weather?\"\n            f\"lat={lat}&lon={lon}&appid={openweather_api_key}&units=metric\"\n        )\n        response = requests.get(url).json()\n        if response.get(\"main\"):\n            temp = response[\"main\"][\"temp\"]\n            desc = response[\"weather\"][0][\"description\"]\n            humidity = response[\"main\"][\"humidity