:44.502554Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# User inputs\nuser_city = input(\"Which city are you exploring today?\")\nuser_preferences = input(\"Your interests (e.g., museums, food, history, nature):\")\nprint(\"How are you feeling today?\")\noptions = [\"adventurous\", \"relaxed\", \"curious\", \"romantic\", \"energetic\"]\n\nfor i, option in enumerate(options, start=1):\n    print(f\"{i}. {option}\")\n\nchoice = int(input(\"Enter the number corresponding to your mood: \"))\n\nif 1 <= choice <= len(options):\n    user_mood = options[choice - 1]\n    print(f\"You selected: {user_mood}\")\nelse:\n    print(\"Invalid choice.\")\n    user_mood = None\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-21T03:40:40.978165Z","iopub.execute_input":"2025-04-21T03:40:40.978481Z","iopub.status.idle":"2025-04-21T03:41:01.476024Z","shell.execute_reply.started":"2025-04-21T03:40:40.978457Z","shell.execute_reply":"2025-04-21T03:41:01.475012Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"if user_city and user_preferences:\n    lang,translated_city_input = language(user_city)\n    \n    \n    lang,translated_user_mood = language(user_mood)\n    \n    lang,translated_preferences_input = language(user_preferences)\n    \n    # ================== Wikipedia Fetch ==================\n    def fetch_wiki_data(city):\n        title = city.replace(\" \", \"_\")\n        URL = \"https://en.wikipedia.org/w/api.php\"\n        PARAMS = {\n            \"action\": \"query\",\n            \"format\": \"json\",\n            \"prop\": \"extracts\",\n            \"titles\": title,\n            \"explaintext\": True,\n            \"exlimit\": 1\n        }\n        response = requests.get(URL, params=PARAMS)\n        pages = response.json()[\"query\"][\"pages\"]\n        page = next(iter(pages.values()))\n        return page.get(\"extract\", \"\")\n\n    wiki_text = fetch_wiki_data(translated_city_input)\n\n    # ================ Weather Fetch ==================\n    def get_weather(city):\n        params = {\n            \"q\": city,\n            \"key\": weather_api_key,\n            \"aqi\": \"yes\"\n        }\n        response = requests.get(\"https://api.weatherapi.com/v1/current.json\", params=params).json()\n        if \"current\" in response:\n            return {\n                \"description\": response[\"current\"][\"condition\"][\"text\"],\n                \"temperature\": response[\"current\"][\"temp_c\"],\n                \"humidity\": response[\"current\"][\"humidity\"],\n                \"wind\": response[\"current\"][\"wind_kph\"]\n            }\n        return {\"description\": \"Data unavailable\"}\n\n    weather_info = get_weather(translated_city_input)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-21T03:41:06.238495Z","iopub.execute_input":"2025-04-21T03:41:06.239303Z","iopub.status.idle":"2025-04-21T03:41:11.985458Z","shell.execute_reply.started":"2025-04-21T03:41:06.239277Z","shell.execute_reply":"2025-04-21T03:41:11.983844Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"llm = ChatGoogleGenerativeAI(model=\"gemini-2.0-flash\",google_api_key = google_api_key)\nsearch = SerpAPIWrapper(serpapi_api_key=serpapi_api_key)\nsearch_tool = Tool(name=\"Search\", func=search.run, description=\"Web search for local food\")\nagent = initialize_agent([search_tool], llm=llm, agent=AgentType.ZERO_SHOT_REACT_DESCRIPTION, verbose=False, handle_parsing_errors=True)\n\n\n\ndef get_food_recs(city):\n    query = f\"Top vegetarian and non-vegetarian food in {city}\"\n    return agent.invoke({\"input\": query})\n\n\n\nfood_recs = get_food_recs(translated_city_input)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-21T03:41:15.997956Z","iopub.execute_input":"2025-04-21T03:41:15.99874Z","iopub.status.idle":"2025-04-21T03:41:26.279859Z","shell.execute_reply.started":"2025-04-21T03:41:15.998714Z","shell.execute_reply":"2025-04-21T03:41:26.27914Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ================ Text Chunking and Embedding ==================\ndef chunk_text(text, chunk_size=5):\n    sentences = sent_tokenize(text)\n    return [\" \".join(sentences[i:i+chunk_size]) for i in range(0, len(sentences), chunk_size)]\n\nchunks = chunk_text(wiki_text)\nembedder = GoogleGenerativeAIEmbeddings(model=\"models/text-embedding-004\", google_api_key = google_api_key)\nembeddings = embedder.embed_documents(chunks)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-21T03:41:34.86837Z","iopub.execute_input":"2025-04-21T03:41:34.869037Z","iopub.status.idle":"2025-04-21T03:41:37.340125Z","shell.execute_reply.started":"2025-04-21T03:41:34.869009Z","shell.execute_reply":"2025-04-21T03:41:37.33927Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# FAISS Vector Index\ndimension = len(embeddings[0])\nindex = faiss.IndexFlatL2(dimension)\nindex.add(np.array(embeddings).astype(\"float32\"))\n\ndef get_custom_tour(query):\n    query_vec = np.array([embedder.embed_query(query)]).astype(\"float32\")\n    D, I = index.search(query_vec, k=5)\n    \n    return \"\\n\\n\".join([chunks[i] for i in I[0]])\n\nuser_query = f\"Suggest a {translated_user_mood} tour in {translated_city_input} that includes {translated_preferences_input}\"\ntour_info = get_custom_tour(user_query)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-21T03:41:40.718415Z","iopub.execute_input":"2025-04-21T03:41:40.718685Z","iopub.status.idle":"2025-04-21T03:41:41.06402Z","shell.execute_reply.started":"2025-04-21T03:41:40.718666Z","shell.execute_reply":"2025-04-21T03:41:41.063192Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"✅ Summary: This code dynamically crafts a friendly, location-aware, and mood-sensitive tour plan using structured prompting and a powerful LLM pipeline, combining RAG (tour info), live APIs (weather/food), and user inputs to produce highly customized travel content.","metadata":{}},{"cell_type":"code","source":"prompt = PromptTemplate(\n        input_variables=[\"city\", \"mood\", \"preferences\", \"weather\", \"tour\", \"food\"],\n        template=\"\"\"\n        You are a friendly and knowledgeable AI travel guide helping users plan a personalized tour.\n\n        Using the following details:\n        - City: {city}\n        - Mood: {mood}\n        - Preferences: {preferences}\n        - Weather: {weather}\n        - Tour Info: {tour}\n        - Food: {food}\n\n        Generate a detailed and engaging travel plan. \n\n        Make sure to:\n        1. Suggest **activities that match the mood and preferences**.\n        2. **Adapt the plan based on the weather** (e.g., indoor if rainy).\n        3. Include **must-see sights or hidden gems** from the tour info.\n        4. Recommend **local dishes or food experiences** tailored to the user.\n        5. Use a friendly and conversational tone throughout.\n        6. End with an inviting summary of the experience.\n\n        Keep the tone warm, positive, and helpful—like a local friend planning a fun day!\n        \"\"\"\n    )\n\nchain = prompt | llm\nresponse = chain.invoke({\n    \"city\": translated_city_input,\n    \"mood\": translated_user_mood,\n    \"preferences\": translated_preferences_input,\n    \"weather\": str(weather_info),\n    \"tour\": tour_info,\n    \"food\": str(food_recs)\n    })","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-21T03:41:55.108478Z","iopub.execute_input":"2025-04-21T03:41:55.108805Z","iopub.status.idle":"2025-04-21T03:42:01.011745Z","shell.execute_reply.started":"2025-04-21T03:41:55.108779Z","shell.execute_reply":"2025-04-21T03:42:01.011025Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"final_response = convert(lang,response.content)\n\ndisplay(Markdown(final_response))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-21T03:42:02.542865Z","iopub.execute_input":"2025-04-21T03:42:02.543662Z","iopub.status.idle":"2025-04-21T03:42:06.739446Z","shell.execute_reply.started":"2025-04-21T03:42:02.543638Z","shell.execute_reply":"2025-04-21T03:42:06.738686Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"<h1>Use Cases & Stretch Goals</h1>\n\n<h3>Real-World Use Cases</h3>\n\n<h5>1. 🎓 Educational Exploration</h5>\nStudents can explore historical sites virtually, gain context about monuments, and learn cultural insights without leaving the classroom.\n\n<h5>2. 🧳 Personalized Trip Planning</h5>\nTravelers can upload a photo or choose a destination to receive a complete travel itinerary, weather updates, food recommendations, and navigation info.\n\n<h5>3. 🗣 Conversational Learning</h5>\nThe AI chatbot interacts like a virtual guide, providing rich historical, architectural, and cultural information through natural conversations.\n\n<h5>4. 🌐 Multilingual Tour Experience</h5>\nUsers can interact in their native language, and the system auto-translates both input and output, creating an inclusive and accessible travel assistant.\n\n\n<h3>Stretch Goals & Future Enhancements</h3>\n\n<h5>1. 🎞 AI-Generated Video Tours (in-progress)</h5>\nTransform the AI-generated landmark descriptions into narrated videos with visuals retrieved from the internet, powered by Gemini and moviepy.\n\n<h5>2. 🧠 User Memory & Profiles</h5>\nPersonalize tours based on user history, past interactions, favorite styles (e.g., nature, architecture), and saved preferences.\n\n<h5>3. 👓 AR/VR Integration</h5>\nBring heritage sites into virtual or augmented reality environments for immersive exploration.\n\n<h5>4. 🧭 Real-Time Tour Assistant</h5>\nUse GPS data and voice interfaces to turn the assistant into a live travel companion during actual visits.\n\n<h5>5. 🗃 Integration with Booking & Transport APIs</h5>\nSeamlessly link recommended sites with transport, ticketing, and accommodation booking platforms.","metadata":{}},{"cell_type":"markdown","source":"✅ Conclusion\n\nVirtuTrek is a powerful fusion of generative AI and cultural tourism, combining tools like Gemini, LangChain, and FAISS to deliver a smart virtual assistant. It analyzes landmark images, generates personalized tour plans, and supports friendly conversations, food, weather, and accommodation insights. With multi-language support and a modular design, VirtuTrek offers an accessible, immersive experience — paving the way for the future of AI-powered travel and heritage exploration.","metadata":{}}]}